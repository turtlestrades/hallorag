# Database Configuration
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpassword
POSTGRES_PORT=5432

# Ollama Endpoint & Models
# Uses your native host Ollama by default (fastest, uses host GPU):
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
